{
  // The API server is compiled in from an env file that is not shipped with
  // the app (see .env.example). F5 uses these, so no flag has to be typed.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Genie (debug, .env)",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define-from-file=.env"]
    },
    {
      "name": "Genie (profile, .env)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=.env"]
    },
    {
      "name": "Genie (release, .env.production)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=.env.production"]
    }
  ]
}
