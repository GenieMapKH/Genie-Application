<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is refused everywhere except this device itself: voice
     messages are played from memory through a local proxy (just_audio's
     StreamAudioSource), which the native player reaches over 127.0.0.1. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
