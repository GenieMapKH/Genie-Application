# Copy to `.env` (debug runs) and `.env.production` (release builds).
# Neither file is committed, and neither is shipped inside the app: the values
# are compiled in when the app is built.
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env.production
#
# A compiled-in value is no longer a readable file in the APK, but it can still
# be dug out of the app. Only public, environment-specific values belong here,
# never a secret (a secret belongs on the server).

# API gateway base URL. Pick the one that matches where you run the app:
#   hosted server .......... https://gateway-production-c0c5.up.railway.app
#   Android emulator ....... http://10.0.2.2:4000
#   iOS simulator / desktop  http://localhost:4000
#   physical phone (Wi-Fi) . http://<your-computer-LAN-IP>:4000
#
# Two devices only see each other's chat messages live when both use the SAME
# server, so when testing across devices either give both the same kind of
# build or point one at the other's server for that run:
#   flutter run --dart-define=API_BASE_URL=https://gateway-production-c0c5.up.railway.app
API_BASE_URL=https://gateway-production-c0c5.up.railway.app
